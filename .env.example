PORT=8080
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=notifications_db
DB_USER=notifications_service
DB_PASSWORD=change_notifications_password
DB_POOL_MAX=5
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY_MS=1000

BROKER_URL=amqp://admin:admin@localhost:5672
BROKER_EXCHANGE=rhm.events
BROKER_QUEUE=notificaciones.queue
BROKER_CONNECT_MAX_ATTEMPTS=5
BROKER_CONNECT_RETRY_DELAY_MS=1000

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=notificaciones@rhm.local
SMTP_USE_TLS=false
